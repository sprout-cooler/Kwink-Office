#!/bin/bash
# 生命周期脚本（V10 8.9）：由飞牛在启动/停止/状态检查时调用。
# 规则（避坑指南 §1.3）：全套脚本 UTF-8 无 BOM + LF；失败必须先写 TRIM_TEMP_LOGFILE 再非零退出。
# S1 真机验证项：compose 文件实际路径（V10 写 ${TRIM_APPDEST}/docker/，
# 若安装后应用内容位于 ${TRIM_APPDEST}/app/ 下则需取第二个候选，按存在者自动回退）。

COMPOSE_CANDIDATES=(
  "${TRIM_APPDEST}/docker/docker-compose.yaml"
  "${TRIM_APPDEST}/app/docker/docker-compose.yaml"
)
PROJECT_NAME="omnioffice"

# v1.0.23：用户数据目录必须是 ${TRIM_PKGVAR}/data —— 与数据库同命，升级保留。
# 原先建在 ${TRIM_APPDEST}/share（安装 target），升级必被清空，导致模板文件丢失、
# 而 DB 记录残留，用户既删不掉也传不上去。**禁止再往安装目录下建数据目录。**
DATA_ROOT="${TRIM_PKGVAR}/data"

resolve_compose() {
  for f in "${COMPOSE_CANDIDATES[@]}"; do
    if [ -f "$f" ]; then
      echo "$f"
      return 0
    fi
  done
  return 1
}

COMPOSE_FILE="$(resolve_compose)" || {
  echo "docker-compose.yaml not found under: ${COMPOSE_CANDIDATES[*]}" > "$TRIM_TEMP_LOGFILE"
  exit 1
}

compose() {
  docker compose -f "$COMPOSE_FILE" -p "$PROJECT_NAME" "$@"
}

case "$1" in
  start)
    # mkdir 失败不能中断启动（容器内也会 ensure_dir），
    # 但必须落日志 —— 目录建不出来会直接导致上传/导出失败。
    if ! mkdir -p "${DATA_ROOT}/uploads" "${DATA_ROOT}/exports" "${DATA_ROOT}/templates"; then
      echo "failed to create data dirs under ${DATA_ROOT}" >> "$TRIM_TEMP_LOGFILE"
    fi
    # 旧安装目录下的遗留数据：仅当新目录为空时才搬，避免覆盖用户现有文件。
    # compose 已把旧目录只读挂到 /legacy-data，服务启动时会再做一次幂等迁移。
    if [ -d "${TRIM_APPDEST}/share" ] && [ -z "$(ls -A "${DATA_ROOT}/templates" 2>/dev/null)" ]; then
      cp -rn "${TRIM_APPDEST}/share/." "${DATA_ROOT}/" 2>/dev/null \
        && echo "legacy data migrated from ${TRIM_APPDEST}/share" >> "$TRIM_TEMP_LOGFILE"
    fi
    compose up -d
    ;;
  stop)
    compose down
    rm -f "${TRIM_APPDEST}/app.sock"
    ;;
  status)
    if compose ps --services --filter status=running | grep -q "api"; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
